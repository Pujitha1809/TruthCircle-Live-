# ==========================================
# TruthCircle Backend Environment Configuration (Render / Local)
# ==========================================

PORT=8000
SERPAPI_API_KEY=your_serpapi_api_key_here
YOU_API_KEY=your_youcom_api_key_here
YDC_API_KEY=your_youcom_api_key_here
NEXCONN_APP_ID=your_nexconn_app_id_here
NEXCONN_SECRET=your_nexconn_secret_here

# Optional: MongoDB Cloud Storage (auto-falls back to local disk if omitted or unreachable)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/truthcircle?retryWrites=true&w=majority

# Production Frontend CORS Domains (Vercel & Custom Domains)
FRONTEND_URL=https://truthcircle.vercel.app
ALLOWED_ORIGINS=https://truthcircle.vercel.app,http://localhost:5173
