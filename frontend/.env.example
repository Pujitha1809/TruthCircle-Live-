# ==========================================
# TruthCircle Frontend Environment Configuration (Vercel / Local)
# ==========================================

# Production API URL (your deployed Render FastAPI backend)
# Local: http://localhost:8000
# Production: https://truthcircle-api.onrender.com
VITE_API_URL=https://truthcircle-api.onrender.com

# Production WebSocket URL
# Optional: frontend dynamically converts https:// -> wss:// from VITE_API_URL if omitted
# Local: ws://localhost:8000
# Production: wss://truthcircle-api.onrender.com
VITE_WS_URL=wss://truthcircle-api.onrender.com

# Nexconn Chat SDK App ID
VITE_NEXCONN_APP_ID=your_nexconn_app_id_here
